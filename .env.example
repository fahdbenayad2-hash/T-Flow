# T-Flow — Environment Variables
# Copy this to .env and fill in your values

# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
APP_SUPABASE_URL=https://your-project-ref.supabase.co
APP_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Apps Script (DO NOT prefix with VITE_ — server only)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# Shared secret for Apps Script proxy — must match the secret in your GAS project
APPS_SCRIPT_SECRET=

# Google OAuth (server only) — used by Integrations > Google Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public production origin, without a trailing slash
PUBLIC_APP_URL=https://orders-azure.vercel.app
# Optional dedicated 32+ character secret. If omitted, the service-role key is used.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_STATE_SECRET=

# Order storage migration
# sheets   = current behavior (safe default)
# shadow   = Sheets primary + best-effort Supabase mirror
# supabase = Supabase primary after import verification
ORDER_STORAGE_MODE=sheets
DEFAULT_STORE_SLUG=main

# Default Admin Email (auto-assigned admin role on first signup)
DEFAULT_ADMIN_EMAIL=fahdbenayad2@gmail.com
